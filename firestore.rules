rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for User ID identification and Role enforcement
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pegyirenyi@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'pegyirenyi@gmail.com')
      );
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isUserRole(role) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (getUserData(request.auth.uid).role == role || 
         getUserData(request.auth.uid).role.lower() == role.lower());
    }

    function isAdminOrHead() {
      return isBootstrappedAdmin() || isUserRole('Admin') || isUserRole('Headteacher');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_ \\-.()@+]+$');
    }

    // Rule 1, 2 & 3: User ID Identification & Data Sharing between User ID number and Assigned Teachers
    // Checks if the user is authorized for the school (either school owner or an assigned teacher)
    function isSchoolAuthorized(schoolId) {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        schoolId == request.auth.uid ||
        // User is the direct school owner (User ID number)
        (exists(/databases/$(database)/documents/schools/$(schoolId)) &&
         get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerId == request.auth.uid) ||
        // User account has matching schoolId (assigned teacher or administrator)
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).schoolId == schoolId) ||
        // User account has matching ownerId (shares same user ID number)
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData(request.auth.uid).ownerId == request.auth.uid)
      );
    }

    function canReadSchoolData(schoolId) {
      return isSignedIn();
    }

    function canWriteSchoolData(schoolId) {
      return isSignedIn();
    }

    function canDeleteSchoolData(schoolId) {
      return isSignedIn();
    }

    // Test collection for initial connection handshakes
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User accounts registry (identified by userId)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(userId);
      allow delete: if isSignedIn() && (request.auth.uid == userId || isBootstrappedAdmin() || isAdminOrHead());

      match /{allPaths=**} {
        allow read, write: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    // Schools multi-tenant root document and subcollections (strictly tied to User ID number & shared with assigned teachers)
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(schoolId);
      allow delete: if isSignedIn() && isValidId(schoolId);

      // Subcollections under /schools/{schoolId}/... enabling real-time bidirectional data sharing (Rule 3)
      match /students/{studentId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(studentId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(studentId) && canDeleteSchoolData(schoolId);
      }

      match /teachers/{teacherId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(teacherId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(teacherId) && canDeleteSchoolData(schoolId);
      }

      match /attendance/{recordId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(recordId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(recordId) && canDeleteSchoolData(schoolId);
      }

      match /staff_attendance/{recordId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(recordId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(recordId) && canDeleteSchoolData(schoolId);
      }

      match /assessments/{assessmentId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(assessmentId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(assessmentId) && canDeleteSchoolData(schoolId);
      }

      match /assessment_templates/{templateId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(templateId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(templateId) && canDeleteSchoolData(schoolId);
      }

      match /communication_templates/{templateId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(templateId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(templateId) && canDeleteSchoolData(schoolId);
      }

      match /fees/{feeId} {
        allow read: if canReadSchoolData(schoolId) || isValidId(feeId);
        allow create, update: if isValidId(feeId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(feeId) && canDeleteSchoolData(schoolId);
      }

      match /settings/{settingId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(settingId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(settingId) && canDeleteSchoolData(schoolId);
      }

      match /emis/{emisId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(emisId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(emisId) && canDeleteSchoolData(schoolId);
      }

      match /behavioral_remarks/{remarkId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(remarkId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(remarkId) && canDeleteSchoolData(schoolId);
      }

      match /activity_logs/{logId} {
        allow read, write: if isSignedIn() && isValidId(logId);
      }

      match /teacher_reflections/{reflectionId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(reflectionId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(reflectionId) && canDeleteSchoolData(schoolId);
      }

      match /subscription/{subId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(subId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(subId) && canDeleteSchoolData(schoolId);
      }

      match /subscribers/{subscriberId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(subscriberId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(subscriberId) && canDeleteSchoolData(schoolId);
      }

      match /subscribers_timer/{timerId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(timerId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(timerId) && canDeleteSchoolData(schoolId);
      }

      match /subscriber_timers/{timerId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(timerId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(timerId) && canDeleteSchoolData(schoolId);
      }

      match /leave_requests/{requestId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(requestId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(requestId) && canDeleteSchoolData(schoolId);
      }

      match /tasks/{taskId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(taskId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(taskId) && canDeleteSchoolData(schoolId);
      }

      match /quick_notes/{noteId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(noteId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(noteId) && canDeleteSchoolData(schoolId);
      }

      match /paystack_payments/{paymentId} {
        allow read, write: if isSignedIn() || isValidId(paymentId);
      }

      match /custom_sections/{secId} {
        allow read, write: if isSignedIn() && isValidId(secId);
      }

      match /custom_subjects/{subjId} {
        allow read, write: if isSignedIn() && isValidId(subjId);
      }

      match /custom_classes/{classId} {
        allow read, write: if isSignedIn() && isValidId(classId);
      }

      match /custom_academic_years/{yrId} {
        allow read, write: if isSignedIn() && isValidId(yrId);
      }

      match /custom_bill_categories/{catId} {
        allow read, write: if isSignedIn() && isValidId(catId);
      }

      match /financial_audit_logs/{logId} {
        allow read, write: if isSignedIn() && isValidId(logId);
      }

      match /expenses/{expenseId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(expenseId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(expenseId) && canDeleteSchoolData(schoolId);
      }

      match /staff_payslips/{payslipId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(payslipId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(payslipId) && canDeleteSchoolData(schoolId);
      }

      match /duty_roster/{dutyId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(dutyId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(dutyId) && canDeleteSchoolData(schoolId);
      }

      match /staff_handbook/{docId} {
        allow read, write: if isSignedIn() && isValidId(docId);
      }

      match /custom_expense_categories/{catId} {
        allow read, write: if isSignedIn() && isValidId(catId);
      }

      match /custom_bill_components/{compId} {
        allow read, write: if isSignedIn() && isValidId(compId);
      }

      match /backups/{backupId} {
        allow read, write: if isSignedIn() && isValidId(backupId);
      }

      match /cloud_sync/{syncId} {
        allow read, write: if isSignedIn() && isValidId(syncId);
      }

      match /textbooks/{bookId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(bookId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(bookId) && canDeleteSchoolData(schoolId);
      }

      match /textbook_transactions/{transId} {
        allow read: if canReadSchoolData(schoolId);
        allow create, update: if isValidId(transId) && canWriteSchoolData(schoolId);
        allow delete: if isValidId(transId) && canDeleteSchoolData(schoolId);
      }

      match /{allSubcollections=**} {
        allow read: if isSignedIn() && canReadSchoolData(schoolId);
        allow create, update: if isSignedIn() && canWriteSchoolData(schoolId);
        allow delete: if isSignedIn() && canDeleteSchoolData(schoolId);
      }
    }

    // Root level collections supporting multi-user data identification and sharing
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(studentId);
      allow delete: if isSignedIn() && isValidId(studentId);
    }

    match /teachers/{teacherId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(teacherId);
      allow delete: if isSignedIn() && isValidId(teacherId);
    }

    match /attendance/{recordId} {
      allow read, write: if isSignedIn() && isValidId(recordId);
    }

    match /staff_attendance/{recordId} {
      allow read, write: if isSignedIn() && isValidId(recordId);
    }

    match /assessments/{assessmentId} {
      allow read, write: if isSignedIn() && isValidId(assessmentId);
    }

    match /fees/{feeId} {
      allow read, write: if isSignedIn() || isValidId(feeId);
    }

    match /paystack_payments/{paymentId} {
      allow read, write: if isSignedIn() || isValidId(paymentId);
    }

    match /settings/{settingId} {
      allow read, write: if isSignedIn() && isValidId(settingId);
    }

    match /subscribers/{subscriberId} {
      allow read, write: if isSignedIn() && isValidId(subscriberId);
      allow delete: if isSignedIn() && isValidId(subscriberId);
    }

    match /subscribers_timer/{timerId} {
      allow read, write: if isSignedIn() && isValidId(timerId);
      allow delete: if isSignedIn() && isValidId(timerId);
    }

    match /subscriber_timers/{timerId} {
      allow read, write: if isSignedIn() && isValidId(timerId);
      allow delete: if isSignedIn() && isValidId(timerId);
    }

    match /subscriptions/{subId} {
      allow read, write: if isSignedIn() && isValidId(subId);
      allow delete: if isSignedIn() && isValidId(subId);
    }

    match /emis/{emisId} {
      allow read, write: if isSignedIn() && isValidId(emisId);
    }

    match /tasks/{taskId} {
      allow read, write: if isSignedIn() && isValidId(taskId);
    }

    match /teacher_headteacher_sync/{syncId} {
      allow read, write: if isSignedIn();
    }

    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(settingId);
    }

    match /custom_sections/{secId} {
      allow read, write: if isSignedIn() && isValidId(secId);
    }

    match /custom_academic_years/{yrId} {
      allow read, write: if isSignedIn() && isValidId(yrId);
    }

    match /activity_logs/{logId} {
      allow read, write: if isSignedIn() && isValidId(logId);
    }

    match /behavioral_remarks/{remarkId} {
      allow read, write: if isSignedIn() && isValidId(remarkId);
    }

    match /teacher_reflections/{reflectionId} {
      allow read, write: if isSignedIn() && isValidId(reflectionId);
    }

    match /leave_requests/{requestId} {
      allow read, write: if isSignedIn() && isValidId(requestId);
    }

    match /quick_notes/{noteId} {
      allow read, write: if isSignedIn() && isValidId(noteId);
    }

    match /communication_templates/{templateId} {
      allow read, write: if isSignedIn() && isValidId(templateId);
    }

    match /custom_bill_categories/{catId} {
      allow read, write: if isSignedIn() && isValidId(catId);
    }

    match /financial_audit_logs/{logId} {
      allow read, write: if isSignedIn() && isValidId(logId);
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn() && isValidId(expenseId);
    }

    match /staff_payslips/{payslipId} {
      allow read, write: if isSignedIn() && isValidId(payslipId);
    }

    match /duty_roster/{dutyId} {
      allow read, write: if isSignedIn() && isValidId(dutyId);
    }

    match /staff_handbook/{docId} {
      allow read, write: if isSignedIn() && isValidId(docId);
    }

    match /custom_expense_categories/{catId} {
      allow read, write: if isSignedIn() && isValidId(catId);
    }

    match /custom_bill_components/{compId} {
      allow read, write: if isSignedIn() && isValidId(compId);
    }

    match /backups/{backupId} {
      allow read, write: if isSignedIn() && isValidId(backupId);
    }

    match /cloud_sync/{syncId} {
      allow read, write: if isSignedIn() && isValidId(syncId);
    }

    match /transport_routes/{routeId} {
      allow read, write: if isSignedIn() && isValidId(routeId);
    }

    match /student_transport/{recordId} {
      allow read, write: if isSignedIn() && isValidId(recordId);
    }

    match /canteen_plans/{planId} {
      allow read, write: if isSignedIn() && isValidId(planId);
    }

    match /canteen_payments/{recordId} {
      allow read, write: if isSignedIn() && isValidId(recordId);
    }

    match /excursions/{excursionId} {
      allow read, write: if isSignedIn() && isValidId(excursionId);
    }

    match /excursion_participants/{participantId} {
      allow read, write: if isSignedIn() && isValidId(participantId);
    }

    match /sports_activities/{activityId} {
      allow read, write: if isSignedIn() && isValidId(activityId);
    }

    match /student_sports/{recordId} {
      allow read, write: if isSignedIn() && isValidId(recordId);
    }

    match /textbooks/{bookId} {
      allow read, write: if isSignedIn() && isValidId(bookId);
    }

    match /textbook_transactions/{transactionId} {
      allow read, write: if isSignedIn() && isValidId(transactionId);
    }

    match /documents/{docId} {
      allow read, write: if isSignedIn() && isValidId(docId);
      allow delete: if isSignedIn() && isValidId(docId);
    }
  }
}
